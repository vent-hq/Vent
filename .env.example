# Configuration reference. Store production values in Doppler (vent / prd).
# Workspace setup does not require a .env file.

# Database + Redis
DATABASE_URL=postgres://vent:password@vent-db.internal:5432/vent
REDIS_URL=redis://default:password@vent-redis.internal:6379

# AI / voice providers
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# WorkOS auth
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://venthq.dev/auth/callback
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=

# JWT signing key: RSA 2048-bit or stronger, PKCS#8 PEM.
JWT_PRIVATE_KEY=

# Platform credential encryption + worker callbacks
# Generate PLATFORM_CONNECTIONS_MASTER_KEY with: openssl rand -hex 32
PLATFORM_CONNECTIONS_MASTER_KEY=
RUNNER_CALLBACK_SECRET=
API_URL=http://vent-api.internal:3000
API_PUBLIC_URL=https://api.venthq.dev
WORKER_TOTAL_CONCURRENCY=2
FLEET_MAX_ACTIVE_RUNS=2

# Tigris (S3-compatible) artifact storage (recordings, audio)
S3_ACCESS_KEY_ID=
S3_BUCKET=vent-recordings-vent213
S3_ENDPOINT=https://t3.storage.dev
S3_REGION=auto
S3_SECRET_ACCESS_KEY=

# Public URLs
DASHBOARD_URL=https://venthq.dev

# Demo CLI provider credential (not needed in the suite JSON)
BLAND_API_KEY=
